{
  "manifest_version": 3,
  "name": "X Follow Overlay",
  "version": "1.2.12",
  "description": "Relationship dots on x.com: mutual, you follow, follows you, and was mutual.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "X Follow Overlay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/page-hook.js", "popup/keys-frame.html"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "shared/sync-state.js",
        "shared/theme.js",
        "shared/sync-identity.js",
        "shared/follow-rest.js",
        "shared/metrics-days.js",
        "shared/graphql-timeline.js",
        "shared/metrics-refill.js",
        "shared/passive-relations.js",
        "shared/ex-mutual.js",
        "shared/metrics-budget.js",
        "shared/x-api.js",
        "shared/key-confirm.js",
        "shared/sync-route.js",
        "shared/incremental-sync.js",
        "content/content.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
